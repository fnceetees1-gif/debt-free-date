{
  "name": "debt-free-date",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "test-engine": "tsx src/calculator.test.ts",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/generate-assets.js",
