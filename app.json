{
  "expo": {
    "name": "Debt Free Date",
    "slug": "debtfree",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "debtfreedate",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.christian.debtpayoffpro",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.christian.debtpayoffpro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B1F3B"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1B1F3B"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1B1F3B"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "revenueCatApiKeyIos": "appl_OgMiCfArEihCODJdVqvwmtyzEow",
      "revenueCatApiKeyAndroid": "goog_BhhsEgcXGWPyhlRAZEQsciqpoSe",
      "eas": {
        "projectId": "aa65ce5c-586b-44ea-bae9-1b445afd2715"
      }
    },
    "owner": "floydchristian"
  }
}
